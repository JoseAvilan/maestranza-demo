# Normaliza los finales de línea: en el repositorio siempre LF, en el disco de
# cada quien lo que corresponda a su sistema. Evita que un clon en Windows y
# otro en Linux muestren el archivo completo como modificado.
* text=auto eol=lf

# Binarios: no tocar.
*.png binary
*.jpg binary
*.svg text eol=lf
*.zip binary
*.woff2 binary
